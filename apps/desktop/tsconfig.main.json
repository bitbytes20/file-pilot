{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src/main",
    "outDir": "dist/main",
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/main.tsbuildinfo",
    "types": ["node", "electron"]
  },
  "include": ["src/main"],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/application"
    },
    {
      "path": "../../packages/infrastructure"
    },
    {
      "path": "../../packages/shared-contracts"
    }
  ],
  "exclude": ["src/**/*.test.ts"]
}
